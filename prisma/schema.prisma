generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  ALUNO
  ADMIN
}

model Usuario {
  id                String    @id @default(uuid())
  nome              String
  email             String    @unique
  dataNascimento    DateTime  @map("data_nascimento") @db.Date
  senhaHash         String    @map("senha_hash")
  termosAceitosEm   DateTime  @map("termos_aceitos_em")
  boasVindasVistaEm DateTime? @map("boas_vindas_vista_em")
  papel             Papel     @default(ALUNO)

  fasesConcluidas FaseConcluida[]
  respostasQuiz   RespostaQuiz[]
  orcamentos      Orcamento[]
  lancamentos     Lancamento[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("usuarios")
}

model FaseConcluida {
  id          String   @id @default(uuid())
  usuarioId   String   @map("usuario_id")
  fase        Int
  xpGanho     Int      @map("xp_ganho")
  concluidaEm DateTime @default(now()) @map("concluida_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, fase])
  @@map("fases_concluidas")
}

model RespostaQuiz {
  id           String   @id @default(uuid())
  usuarioId    String   @map("usuario_id")
  fase         Int
  cardId       String   @map("card_id")
  acertou      Boolean
  respondidaEm DateTime @updatedAt @map("respondida_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, fase, cardId])
  @@map("respostas_quiz")
}

model Orcamento {
  id        String  @id @default(uuid())
  usuarioId String  @map("usuario_id")
  mes       String  @db.VarChar(7)
  renda     Decimal @db.Decimal(12, 2)

  usuario    Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categorias OrcamentoCategoria[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([usuarioId, mes])
  @@map("orcamentos")
}

model OrcamentoCategoria {
  id          String  @id @default(uuid())
  orcamentoId String  @map("orcamento_id")
  categoria   String
  valor       Decimal @db.Decimal(12, 2)

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@unique([orcamentoId, categoria])
  @@map("orcamento_categorias")
}

model Lancamento {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  categoria  String
  descricao  String   @default("")
  valorTotal Decimal  @map("valor_total") @db.Decimal(12, 2)
  parcelas   Int      @default(1)
  data       DateTime @db.Date

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([usuarioId, data])
  @@map("lancamentos")
}

model Indicador {
  codigo     String   @id
  valor      Decimal  @db.Decimal(7, 4)
  referencia DateTime @db.Date
  buscadoEm  DateTime @map("buscado_em")

  @@map("indicadores")
}
