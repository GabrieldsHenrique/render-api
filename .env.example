# Copie este arquivo para .env e preencha os valores.
# O .env NÃO vai para o git (tem segredos); este .env.example vai, como modelo.

DATABASE_URL="postgresql://render:render@localhost:5432/render?schema=public"

# Chave que assina os tokens de login (JWT). Gere uma aleatória com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Endereços do front que podem chamar a API (CORS). Vários: separar por vírgula
FRONT_URL="http://localhost:4200"
